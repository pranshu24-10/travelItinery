# Personalized Travel Itinerary Planner / TravelEase
# Environment Configuration

# Backend Settings
PROJECT_NAME="Personalized Travel Itinerary Planner"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-replace-with-secure-random-32-chars-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local SQLite (runs immediately without external services)
DATABASE_URL="sqlite:///./travel_planner.db"
# Production Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth and Storage (Optional for production)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# AI Provider Configuration
# Supported providers: "gemini", "openai", "demo"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Note: If no AI API key is configured, TravelEase automatically operates in its
# Intelligent Curated Fallback Engine mode with realistic schedules and estimates!

# Frontend Settings (in frontend/.env)
# VITE_API_URL="http://127.0.0.1:8000"
